# Bright Data credentials
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here
# Zone names are account-specific — check your Bright Data dashboard.
# List them via: GET https://api.brightdata.com/zone/get_active_zones (Bearer token).
# Common defaults are like serp_api1 (type=serp) and web_unlocker1 (type=unblocker).
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
BRIGHTDATA_USERNAME=your_brightdata_username
BRIGHTDATA_PASSWORD=your_brightdata_password
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=22225

# LLM provider for extraction — AI/ML API (aimlapi.com), OpenAI-compatible.
# Get the key at https://aimlapi.com → Dashboard → API Keys.
LLM_API_KEY=your_aimlapi_key_here
LLM_BASE_URL=https://api.aimlapi.com/v1
# Claude on AI/ML API (matches the tuned prompt). Switch to openai/gpt-5-2 etc. if you prefer.
LLM_MODEL=claude-sonnet-4-5

# Optional: only needed if you point LLM_BASE_URL back at Anthropic directly.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# App settings
DATABASE_URL=./risk_radar.db
VENDORS_CSV=./vendors.csv
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MCP Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
